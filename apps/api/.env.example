APP_NAME=Research Bridge API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://research_bridge:research_bridge_dev@localhost:5432/research_bridge
DATABASE_ECHO=false
DEMO_OWNER_ID=00000000-0000-4000-8000-000000000001
# Optional server-only key: https://openalex.org/settings/api
# OPENALEX_API_KEY=replace-with-your-local-key
OPENALEX_BASE_URL=https://api.openalex.org
# Official public ATS origin plus the repository-owned research-organization
# allowlist. The browser can neither add a board nor supply an outbound URL.
GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io
GREENHOUSE_ENABLED_BOARDS=thealleninstitute,constructorknowledgelabs,centerforstrategicandinternationalstudiesinc,verainstituteofjustice
OPPORTUNITY_STALE_AFTER_HOURS=168
# Optional server-only key for structured outreach generation. Without it, the
# application uses the deterministic evidence-grounded template.
# OPENAI_API_KEY=replace-with-your-local-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OUTREACH_MODEL=gpt-5.6-terra
# Versioned Phase 7 relevance policy. These five values must total 1.0.
MENTOR_QUERY_EVIDENCE_WEIGHT=0.35
MENTOR_PROFILE_ALIGNMENT_WEIGHT=0.25
MENTOR_SUPPORTING_DEPTH_WEIGHT=0.15
MENTOR_RECENT_ACTIVITY_WEIGHT=0.15
MENTOR_EVIDENCE_COMPLETENESS_WEIGHT=0.10
