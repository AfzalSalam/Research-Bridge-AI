APP_NAME=Research Bridge API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://research_bridge:research_bridge_dev@localhost:5433/research_bridge
DATABASE_ECHO=false
DEMO_OWNER_ID=00000000-0000-4000-8000-000000000001
# Optional server-only key: https://openalex.org/settings/api
# OPENALEX_API_KEY=replace-with-your-local-key
OPENALEX_BASE_URL=https://api.openalex.org
# Official public ATS origin plus the repository-owned research-organization
# allowlist. The browser can neither add a board nor supply an outbound URL.
GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io
GREENHOUSE_ENABLED_BOARDS=thealleninstitute,constructorknowledgelabs,centerforstrategicandinternationalstudiesinc,verainstituteofjustice
OPPORTUNITY_STALE_AFTER_HOURS=168
# Optional server-only key for structured outreach generation. Without it, the
# application uses the deterministic evidence-grounded template.
# OPENAI_API_KEY=replace-with-your-local-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OUTREACH_MODEL=gpt-5.6-terra
# Versioned Phase 7 relevance policy. These five values must total 1.0.
MENTOR_QUERY_EVIDENCE_WEIGHT=0.35
MENTOR_PROFILE_ALIGNMENT_WEIGHT=0.25
MENTOR_SUPPORTING_DEPTH_WEIGHT=0.15
MENTOR_RECENT_ACTIVITY_WEIGHT=0.15
MENTOR_EVIDENCE_COMPLETENESS_WEIGHT=0.10

# Use the same project origin as the frontend. Never add a service-role key there.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Private paper processing (server only; never expose these to the frontend)
SUPABASE_STORAGE_SERVICE_KEY=
DOCUMENT_STORAGE_BUCKET=research-documents
DOCUMENT_SCANNER_HOST=
DOCUMENT_SCANNER_PORT=3310

# Enable only after private Storage, scanner and continuous worker validation
DOCUMENT_UPLOADS_ENABLED=false

# Enable only with PostgreSQL, an indexing worker, and consent UI deployed.
DOCUMENT_INDEXING_ENABLED=false
DOCUMENT_EMBEDDING_DAILY_LIMIT=1000000

# Paper semantic search provider (independent of outreach generation)
DOCUMENT_EMBEDDING_PROVIDER=openai
# For Gemini set DOCUMENT_EMBEDDING_PROVIDER=gemini and add the server-only key:
# GEMINI_API_KEY=replace-with-your-local-key
# Free-tier Gemini submissions may be used by Google to improve products.

# Experimental paper answers: keep disabled until evaluation and setup are complete.
DOCUMENT_ANSWERS_ENABLED=false
DOCUMENT_ANSWER_DAILY_CALL_LIMIT=30
